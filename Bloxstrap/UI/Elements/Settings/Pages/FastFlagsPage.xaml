<ui:UiPage x:Class="Bloxstrap.UI.Elements.Settings.Pages.FastFlagsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:models="clr-namespace:Bloxstrap.UI.ViewModels"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:resources="clr-namespace:Bloxstrap.Resources"
      xmlns:controls="clr-namespace:Bloxstrap.UI.Elements.Controls"
      mc:Ignorable="d"
      d:DesignHeight="1500" d:DesignWidth="800"
      Title="FastFlagsPage"
      Scrollable="True"
      Loaded="Page_Loaded">
    <StackPanel Margin="0,0,14,14">
        <controls:OptionControl 
            Header="{x:Static resources:Strings.Menu_FastFlags_ManagerEnabled_Title}"
            Description="{x:Static resources:Strings.Menu_FastFlags_ManagerEnabled_Description}">
            <ui:ToggleSwitch IsChecked="{Binding UseFastFlagManager, Mode=TwoWay}" />
        </controls:OptionControl>

        <Border Style="{StaticResource SectionSeparator}" />
        <TextBlock Text="{x:Static resources:Strings.Common_Presets}" Style="{StaticResource SectionTitle}" />
        <TextBlock Text="{x:Static resources:Strings.Menu_FastFlags_Presets_Description}" Style="{StaticResource SectionDescription}" />

        <TextBlock Text="{x:Static resources:Strings.Menu_FastFlags_Presets_Categories_Rendering}" Style="{StaticResource SubsectionTitle}" />
        <controls:MarkdownTextBlock MarkdownText="{Binding Source={x:Static resources:Strings.Menu_FastFlags_Presets_D3DExclusiveFullscreenInfo}, Converter={StaticResource StringFormatConverter}, ConverterParameter='https://bloxstraplabs.com/wiki/features/engine-settings/#exclusive-fullscreen'}"  Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <controls:OptionControl 
            Header="{x:Static resources:Strings.Menu_FastFlags_Presets_MSAA_Title}">
            <ComboBox Margin="5,0,0,0" Padding="10,5,10,5" Width="200" ItemsSource="{Binding MSAALevels.Keys, Mode=OneTime}" Text="{Binding SelectedMSAALevel, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </controls:OptionControl>

        <controls:OptionControl 
            Header="{x:Static resources:Strings.Menu_FastFlags_Presets_FixDisplayScaling_Title}" 
            Description="{x:Static resources:Strings.Menu_FastFlags_Presets_FixDisplayScaling_Description}" 
            HelpLink="https://bloxstraplabs.com/wiki/features/engine-settings/#preserving-rendering-quality">
            <ui:ToggleSwitch IsChecked="{Binding FixDisplayScaling, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl 
            Header="{x:Static resources:Strings.Menu_FastFlags_Presets_TextureQuality_Title}">
            <ComboBox Margin="5,0,0,0" Padding="10,5,10,5" Width="200" ItemsSource="{Binding TextureQualities.Keys, Mode=OneTime}" Text="{Binding SelectedTextureQuality, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </controls:OptionControl>


        <controls:OptionControl
            Header="{x:Static resources:Strings.Menu_FastFlags_Presets_RenderingMode_Title}"
            Description="{x:Static resources:Strings.Menu_FastFlags_Presets_RenderingMode_Description}">
            <ComboBox Width="200" Padding="10,5,10,5" ItemsSource="{Binding RenderingModes, Mode=OneTime}" SelectedItem="{Binding SelectedRenderingMode, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </controls:OptionControl>

        <controls:OptionControl
            Header="{x:Static resources:Strings.Menu_FastFlags_Presets_QualityOverride_Title}"
            Description="{x:Static resources:Strings.Menu_FastFlags_Presets_QualityOverride_Description}">
            <ComboBox Width="200" Padding="10,5,10,5" ItemsSource="{Binding QualityLevels, Mode=OneTime}" SelectedItem="{Binding SelectedQualityLevel, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl
            Header="{x:Static resources:Strings.Menu_FastFlags_Presets_PauseVoxelizer_Title}"
            Description="{x:Static resources:Strings.Menu_FastFlags_Presets_PauseVoxelizer_Description}">
            <ui:ToggleSwitch IsChecked="{Binding PauseVoxelizer, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl
            Header="{x:Static resources:Strings.Menu_FastFlags_Presets_GraySky_Title}"
            Description="{x:Static resources:Strings.Menu_FastFlags_Presets_GraySky_Description}">
            <ui:ToggleSwitch IsChecked="{Binding GraySky, Mode=TwoWay}" />
        </controls:OptionControl>

        <TextBlock Text="{x:Static resources:Strings.Menu_FastFlags_Presets_Categories_Geometry}" Style="{StaticResource SubsectionTitle}" />

        <controls:OptionControl
            Header="{x:Static resources:Strings.Menu_FastFlags_Presets_DisableGrass_Title}"
            Description="{x:Static resources:Strings.Menu_FastFlags_Presets_DisableGrass_Description}">
            <ui:ToggleSwitch IsChecked="{Binding DisableGrass, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl
            Header="{x:Static resources:Strings.Menu_FastFlags_Presets_MeshDetail_Title}"
            Description="{x:Static resources:Strings.Menu_FastFlags_Presets_MeshDetail_Description}">
            <StackPanel Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static resources:Strings.Menu_FastFlags_Presets_MeshDetail_Low}" />
                <Slider Width="160" Minimum="0" Maximum="5" IsSnapToTickEnabled="True" TickFrequency="1" TickPlacement="BottomRight" Value="{Binding MeshDetail, Mode=TwoWay}" />
                <TextBlock VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static resources:Strings.Common_Default}" />
            </StackPanel>
        </controls:OptionControl>

        <Border Style="{StaticResource SectionSeparator}" />
        <TextBlock Text="{x:Static resources:Strings.Menu_FastFlags_Allowlist_Title}" Style="{StaticResource SectionTitle}" />
        <TextBlock Text="{x:Static resources:Strings.Menu_FastFlags_Allowlist_Description}" Style="{StaticResource SectionDescription}" />

        <ItemsControl ItemsSource="{Binding AllowlistedFlags, Mode=OneTime}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <controls:OptionControl Header="{Binding Name, Mode=OneTime}" Description="{Binding Description, Mode=OneTime}">
                        <Grid>
                            <ui:ToggleSwitch IsChecked="{Binding BoolValue, Mode=TwoWay}" Visibility="{Binding BoolVisibility, Mode=OneTime}" />
                            <ui:TextBox Width="120" Margin="5,0,0,0" Padding="10,5,10,5" PlaceholderText="{x:Static resources:Strings.Common_Default}" Text="{Binding NumberValue, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" PreviewTextInput="ValidateInt32" Visibility="{Binding NumberVisibility, Mode=OneTime}" />
                        </Grid>
                    </controls:OptionControl>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Style="{StaticResource SectionSeparator}" />
        <TextBlock Text="{x:Static resources:Strings.Menu_FastFlags_Profiles_Title}" Style="{StaticResource SectionTitle}" />
        <TextBlock Text="{x:Static resources:Strings.Menu_FastFlags_Profiles_Description}" Style="{StaticResource SectionDescription}" />

        <controls:OptionControl Header="{x:Static resources:Strings.Menu_FastFlags_Profiles_Saved}">
            <StackPanel Orientation="Horizontal">
                <ComboBox Width="200" Padding="10,5,10,5" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}" />
                <ui:Button Margin="8,0,0,0" Icon="ArrowDownload24" Content="{x:Static resources:Strings.Menu_FastFlags_Profiles_Load}" Command="{Binding LoadProfileCommand}" />
                <ui:Button Margin="8,0,0,0" Icon="Delete24" Appearance="Danger" Command="{Binding DeleteProfileCommand}" />
            </StackPanel>
        </controls:OptionControl>

        <controls:OptionControl Header="{x:Static resources:Strings.Menu_FastFlags_Profiles_SaveCurrent}">
            <StackPanel Orientation="Horizontal">
                <ui:TextBox Width="200" Padding="10,5,10,5" PlaceholderText="{x:Static resources:Strings.Menu_FastFlags_Profiles_NamePlaceholder}" Text="{Binding NewProfileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <ui:Button Margin="8,0,0,0" Icon="Save24" Content="{x:Static resources:Strings.Common_Save}" Command="{Binding SaveProfileCommand}" />
            </StackPanel>
        </controls:OptionControl>

        <controls:OptionControl
            Margin="0,24,0,0"
            Header="{x:Static resources:Strings.Menu_FastFlags_Reset_Title}">
            <ui:ToggleSwitch IsChecked="{Binding ResetConfiguration, Mode=TwoWay}" />
        </controls:OptionControl>

        <ui:CardAction Margin="0,8,0,0" Icon="EditSettings24" Command="{Binding OpenFastFlagEditorCommand}">
            <StackPanel>
                <TextBlock FontSize="14" Text="{x:Static resources:Strings.Menu_FastFlagEditor_Title}" />
                <TextBlock Margin="0,2,0,0" FontSize="12" Text="{x:Static resources:Strings.Menu_FastFlags_Editor_Description}" Padding="0,0,16,0"  Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </StackPanel>
        </ui:CardAction>
    </StackPanel>
</ui:UiPage>
