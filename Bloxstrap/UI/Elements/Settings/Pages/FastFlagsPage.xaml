<ui:UiPage x:Class="Bloxstrap.UI.Elements.Settings.Pages.FastFlagsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:models="clr-namespace:Bloxstrap.UI.ViewModels"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:resources="clr-namespace:Bloxstrap.Resources"
      xmlns:controls="clr-namespace:Bloxstrap.UI.Elements.Controls"
      mc:Ignorable="d"
      d:DesignHeight="1500" d:DesignWidth="800"
      Title="FastFlagsPage"
      Scrollable="True"
      Loaded="Page_Loaded">
    <StackPanel Margin="0,0,14,14">
        <controls:LumiPageHeader PageTitle="{x:Static resources:Strings.Menu_FastFlags_Title}"
                                 Description="{x:Static resources:Strings.Menu_FastFlags_Description}" />

        <ui:InfoBar Margin="0,0,0,8" Padding="8" Title="{x:Static resources:Strings.Common_Warning}"
                    Message="{x:Static resources:Strings.Menu_FastFlags_AllowlistWarning}"
                    Severity="Warning" IsOpen="True" IsClosable="False" />

        <controls:OptionControl 
            Header="{x:Static resources:Strings.Menu_FastFlags_ManagerEnabled_Title}"
            Description="{x:Static resources:Strings.Menu_FastFlags_ManagerEnabled_Description}">
            <ui:ToggleSwitch IsChecked="{Binding UseFastFlagManager, Mode=TwoWay}" />
        </controls:OptionControl>

        <TextBlock Text="{x:Static resources:Strings.Common_Presets}" FontSize="20" FontWeight="Medium" Margin="0,16,0,0" />

        <TextBlock Text="{x:Static resources:Strings.Menu_FastFlags_Presets_Categories_Rendering}" FontSize="16" FontWeight="Medium" Margin="0,16,0,0" />
        <controls:MarkdownTextBlock MarkdownText="{Binding Source={x:Static resources:Strings.Menu_FastFlags_Presets_D3DExclusiveFullscreenInfo}, Converter={StaticResource StringFormatConverter}, ConverterParameter='https://bloxstraplabs.com/wiki/features/engine-settings/#exclusive-fullscreen'}"  Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <ui:Card Margin="0,8,0,0" Padding="12">
            <StackPanel>
                <TextBlock Text="{x:Static resources:Strings.Menu_FastFlags_MeshDetail_Title}" FontSize="14" FontWeight="Medium" />
                <TextBlock Margin="0,3,0,8" Text="{x:Static resources:Strings.Menu_FastFlags_MeshDetail_Description}"
                           FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                <ui:ToggleSwitch IsChecked="{Binding MeshDetailEnabled, Mode=TwoWay}"
                                 Content="{x:Static resources:Strings.Menu_FastFlags_MeshDetail_Enable}" />
                <Grid Margin="0,10,0,0" IsEnabled="{Binding MeshDetailEnabled}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{x:Static resources:Strings.Common_LowestQuality}" VerticalAlignment="Center" />
                    <Slider Grid.Column="1" Margin="8,0" Minimum="0" Maximum="3" TickFrequency="1"
                            IsSnapToTickEnabled="True" Value="{Binding MeshDetail, Mode=TwoWay}" />
                    <TextBlock Grid.Column="2" Text="{x:Static resources:Strings.Common_HighestQuality}" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </ui:Card>

        <controls:OptionControl Header="{x:Static resources:Strings.Menu_FastFlags_Presets_RenderingMode_Title}"
                                Description="{x:Static resources:Strings.Menu_FastFlags_Presets_RenderingMode_Description}">
            <ComboBox Margin="5,0,0,0" Padding="10,5,10,5" Width="200"
                      ItemsSource="{Binding RenderingModes.Keys, Mode=OneTime}"
                      SelectedItem="{Binding SelectedRenderingMode, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </controls:OptionControl>

        <controls:OptionControl 
            Header="{x:Static resources:Strings.Menu_FastFlags_Presets_MSAA_Title}">
            <ComboBox Margin="5,0,0,0" Padding="10,5,10,5" Width="200" ItemsSource="{Binding MSAALevels.Keys, Mode=OneTime}" Text="{Binding SelectedMSAALevel, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </controls:OptionControl>

        <controls:OptionControl 
            Header="{x:Static resources:Strings.Menu_FastFlags_Presets_FixDisplayScaling_Title}" 
            Description="{x:Static resources:Strings.Menu_FastFlags_Presets_FixDisplayScaling_Description}" 
            HelpLink="https://bloxstraplabs.com/wiki/features/engine-settings/#preserving-rendering-quality">
            <ui:ToggleSwitch IsChecked="{Binding FixDisplayScaling, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl 
            Header="{x:Static resources:Strings.Menu_FastFlags_Presets_TextureQuality_Title}">
            <ComboBox Margin="5,0,0,0" Padding="10,5,10,5" Width="200" ItemsSource="{Binding TextureQualities.Keys, Mode=OneTime}" Text="{Binding SelectedTextureQuality, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </controls:OptionControl>

        <ui:Card Margin="0,8,0,0" Padding="12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="{x:Static resources:Strings.Menu_FastFlags_FRMQualityOverride_Title}" FontSize="14" FontWeight="Medium" />
                        <TextBlock Margin="0,3,0,0" Text="{x:Static resources:Strings.Menu_FastFlags_FRMQualityOverride_Description}"
                                   FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding FRMQualityOverrideEnabled, Mode=TwoWay}" />
                </Grid>
                <ui:InfoBar Margin="0,10,0,0" Padding="8" Title="{x:Static resources:Strings.Common_Warning}"
                            Message="{x:Static resources:Strings.Menu_FastFlags_FRMQualityOverride_Warning}"
                            Severity="Warning" IsOpen="True" IsClosable="False" />
                <Grid Margin="0,10,0,0" IsEnabled="{Binding FRMQualityOverrideEnabled}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{x:Static resources:Strings.Common_LowestQuality}" VerticalAlignment="Center" />
                    <Slider Grid.Column="1" Margin="8,0" Minimum="1" Maximum="21" TickFrequency="1"
                            IsSnapToTickEnabled="True" Value="{Binding FRMQualityOverride, Mode=TwoWay}" />
                    <TextBlock Grid.Column="2" Text="{x:Static resources:Strings.Common_HighestQuality}" VerticalAlignment="Center" />
                    <Border Grid.Column="3" Margin="8,0,0,0" Padding="6,2" CornerRadius="4"
                            Background="{ui:ThemeResource SolidBackgroundFillColorSecondaryBrush}">
                        <TextBlock Text="{Binding FRMQualityOverride}" MinWidth="20" TextAlignment="Center" />
                    </Border>
                </Grid>
            </StackPanel>
        </ui:Card>

        <controls:OptionControl 
            Margin="0,24,0,0"
            Header="{x:Static resources:Strings.Menu_FastFlags_Reset_Title}">
            <ui:ToggleSwitch IsChecked="{Binding ResetConfiguration, Mode=TwoWay}" />
        </controls:OptionControl>

        <ui:CardAction Margin="0,8,0,0" Icon="EditSettings24" Command="{Binding OpenFastFlagEditorCommand}" Visibility="{Binding CanShowFastFlagEditor}">
            <StackPanel>
                <TextBlock FontSize="14" Text="{x:Static resources:Strings.Menu_FastFlagEditor_Title}" />
                <TextBlock Margin="0,2,0,0" FontSize="12" Text="{x:Static resources:Strings.Menu_FastFlags_Editor_Description}" Padding="0,0,16,0"  Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </StackPanel>
        </ui:CardAction>
    </StackPanel>
</ui:UiPage>
