<ui:UiPage x:Class="Bloxstrap.UI.Elements.Settings.Pages.RegionSelectorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:Bloxstrap.UI.Elements.Controls"
      xmlns:dmodels="clr-namespace:Bloxstrap.UI.ViewModels.Settings"
      xmlns:resources="clr-namespace:Bloxstrap.Resources"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance dmodels:RegionSelectorViewModel}"
      d:DesignHeight="800" d:DesignWidth="800"
      Title="RegionSelectorPage"
      Scrollable="True">
    <StackPanel Margin="0,0,14,14">
        <TextBlock Text="{x:Static resources:Strings.Menu_RegionSelector_Matchmaking_Title}" Style="{StaticResource SectionTitle}" />
        <TextBlock Text="{x:Static resources:Strings.Menu_RegionSelector_Matchmaking_Description}" Style="{StaticResource SectionDescription}" />

        <controls:OptionControl
            Header="{x:Static resources:Strings.Menu_RegionSelector_BetterMatchmaking_Title}"
            Description="{x:Static resources:Strings.Menu_RegionSelector_BetterMatchmaking_Description}"
            x:Name="MatchmakingOption">
            <ui:ToggleSwitch IsChecked="{Binding BetterMatchmaking, Mode=TwoWay}" />
        </controls:OptionControl>

        <StackPanel IsEnabled="{Binding InnerContent.IsChecked, ElementName=MatchmakingOption, Mode=OneWay}">
            <controls:OptionControl
                Header="{x:Static resources:Strings.Menu_RegionSelector_Preferred_Title}"
                Description="{x:Static resources:Strings.Menu_RegionSelector_Preferred_Description}">
                <ComboBox Width="240" Padding="10,5,10,5" ItemsSource="{Binding PreferredRegions}" SelectedItem="{Binding PreferredRegion, Mode=TwoWay}" DisplayMemberPath="DisplayName" />
            </controls:OptionControl>

            <controls:OptionControl
                Header="{x:Static resources:Strings.Menu_RegionSelector_Randomize_Title}"
                Description="{x:Static resources:Strings.Menu_RegionSelector_Randomize_Description}">
                <ui:ToggleSwitch IsChecked="{Binding RandomizeMatchmaking, Mode=TwoWay}" />
            </controls:OptionControl>
        </StackPanel>

        <Border Style="{StaticResource SectionSeparator}" />
        <TextBlock Text="{x:Static resources:Strings.Menu_RegionSelector_Browse_Title}" Style="{StaticResource SectionTitle}" />
        <TextBlock Text="{x:Static resources:Strings.Menu_RegionSelector_Browse_Description}" Style="{StaticResource SectionDescription}" />

        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox Grid.Column="0" Icon="Search24" PlaceholderText="{x:Static resources:Strings.Menu_QuickPlay_Search_Placeholder}" Text="{Binding GameQuery, UpdateSourceTrigger=PropertyChanged}" KeyDown="GameTextBox_KeyDown" />
            <ComboBox Grid.Column="1" Width="220" Margin="8,0,0,0" Padding="10,5,10,5" ItemsSource="{Binding Regions}" SelectedItem="{Binding SelectedRegion, Mode=TwoWay}" DisplayMemberPath="DisplayName" />
            <ui:Button Grid.Column="2" Margin="8,0,0,0" Height="36" Appearance="Primary" Content="{x:Static resources:Strings.Menu_QuickPlay_Search_Button}" Command="{Binding SearchCommand}" />
        </Grid>

        <TextBlock Margin="0,12,0,0" Text="{Binding StatusText}" Visibility="{Binding StatusVisibility}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <ItemsControl ItemsSource="{Binding Servers}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ui:CardControl Margin="0,8,0,0" Padding="12">
                        <ui:CardControl.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Globe24" FontSize="18" VerticalAlignment="Center" />
                                <TextBlock Margin="8,0,0,0" FontSize="14" VerticalAlignment="Center" Text="{Binding Location}" />
                                <TextBlock Margin="16,0,0,0" FontSize="12" VerticalAlignment="Center" Text="{Binding Details}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:Button Icon="Play24" Content="{x:Static resources:Strings.Menu_QuickPlay_Join}" Command="{Binding DataContext.JoinServerCommand, RelativeSource={RelativeSource AncestorType=ui:UiPage}}" CommandParameter="{Binding}" />
                    </ui:CardControl>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ui:Button Margin="0,12,0,0" HorizontalAlignment="Center" Icon="ArrowDown24" Content="{x:Static resources:Strings.Menu_RegionSelector_LoadMore}" Visibility="{Binding LoadMoreVisibility}" Command="{Binding LoadMoreCommand}" />
    </StackPanel>
</ui:UiPage>
