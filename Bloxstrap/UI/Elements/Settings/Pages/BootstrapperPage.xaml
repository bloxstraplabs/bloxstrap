<ui:UiPage x:Class="Bloxstrap.UI.Elements.Settings.Pages.BehaviourPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:local="clr-namespace:Bloxstrap.UI.Elements.Settings.Pages"
      xmlns:controls="clr-namespace:Bloxstrap.UI.Elements.Controls"
      xmlns:models="clr-namespace:Bloxstrap.UI.ViewModels.Settings"
      xmlns:resources="clr-namespace:Bloxstrap.Resources"
      d:DataContext="{d:DesignInstance Type=models:BehaviourViewModel}"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="800"
      Title="BehaviourPage"
      Scrollable="True">

    <StackPanel Margin="0,0,14,14">
        <controls:OptionControl 
            Header="{x:Static resources:Strings.Menu_Behaviour_ConfirmLaunches_Title}"
            Description="{x:Static resources:Strings.Menu_Behaviour_ConfirmLaunches_Description}">
            <ui:ToggleSwitch IsChecked="{Binding ConfirmLaunches, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl 
            Header="{x:Static resources:Strings.Menu_Behaviour_MultiInstance_Title}"
            Description="{x:Static resources:Strings.Menu_Behaviour_MultiInstance_Description}">
            <ui:ToggleSwitch IsChecked="{Binding MultiInstanceLaunching, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl 
            Header="{x:Static resources:Strings.Menu_Behaviour_BackgroundUpdates_Title}"
            Description="{x:Static resources:Strings.Menu_Behaviour_BackgroundUpdates_Description}">
            <ui:ToggleSwitch IsChecked="{Binding BackgroundUpdates, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl 
            Header="{x:Static resources:Strings.Menu_Behaviour_ForceRobloxReinstall_Title}"
            Description="{x:Static resources:Strings.Menu_Behaviour_ForceRobloxReinstall_Description}">
            <controls:OptionControl.Style>
                <Style TargetType="controls:OptionControl">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsRobloxInstallationMissing, Mode=OneTime}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </controls:OptionControl.Style>
            <ui:ToggleSwitch IsChecked="{Binding ForceRobloxReinstallation, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl
            Header="{x:Static resources:Strings.Menu_Behaviour_Priority_Title}"
            Description="{x:Static resources:Strings.Menu_Behaviour_Priority_Description}">
            <ComboBox Width="200" Padding="10,5,10,5" ItemsSource="{Binding PriorityLevels, Mode=OneTime}" SelectedItem="{Binding RobloxPriority, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </controls:OptionControl>

        <controls:OptionControl 
            Header="{x:Static resources:Strings.Menu_Behaviour_Throttle_Title}"
            Description="{x:Static resources:Strings.Menu_Behaviour_Throttle_Description}">
            <ui:ToggleSwitch IsChecked="{Binding ThrottleInBackground, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl
            Header="{x:Static resources:Strings.Menu_Behaviour_Affinity_Title}"
            Description="{x:Static resources:Strings.Menu_Behaviour_Affinity_Description}">
            <ui:TextBox Width="200" Padding="10,5,10,5" PlaceholderText="0-3, 6" Text="{Binding RobloxCpuAffinity, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
        </controls:OptionControl>

        <controls:OptionControl
            Header="{x:Static resources:Strings.Menu_Behaviour_CloseCrashHandler_Title}"
            Description="{x:Static resources:Strings.Menu_Behaviour_CloseCrashHandler_Description}">
            <ui:ToggleSwitch IsChecked="{Binding CloseCrashHandler, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl
            Header="{x:Static resources:Strings.Menu_Behaviour_ForceLanguage_Title}"
            Description="{x:Static resources:Strings.Menu_Behaviour_ForceLanguage_Description}">
            <ui:ToggleSwitch IsChecked="{Binding ForceRobloxLanguage, Mode=TwoWay}" />
        </controls:OptionControl>

        <Border Style="{StaticResource SectionSeparator}" />
        <TextBlock Text="{x:Static resources:Strings.Menu_Behaviour_Cleaner_Title}" Style="{StaticResource SectionTitle}" />
        <TextBlock Text="{x:Static resources:Strings.Menu_Behaviour_Cleaner_Description}" Style="{StaticResource SectionDescription}" />

        <controls:OptionControl Header="{x:Static resources:Strings.Menu_Behaviour_Cleaner_Age}">
            <ComboBox Width="200" Padding="10,5,10,5" ItemsSource="{Binding CleanerAges, Mode=OneTime}" SelectedItem="{Binding CleanerAge, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </controls:OptionControl>

        <controls:OptionControl Header="{x:Static resources:Strings.Menu_Behaviour_Cleaner_Folders}">
            <StackPanel>
                <CheckBox Content="{x:Static resources:Strings.Menu_Behaviour_Cleaner_RobloxLogs}" IsChecked="{Binding CleanRobloxLogs, Mode=TwoWay}" />
                <CheckBox Content="{x:Static resources:Strings.Menu_Behaviour_Cleaner_RobloxCache}" IsChecked="{Binding CleanRobloxCache, Mode=TwoWay}" />
                <CheckBox Content="{x:Static resources:Strings.Menu_Behaviour_Cleaner_AppLogs}" IsChecked="{Binding CleanAppLogs, Mode=TwoWay}" />
                <CheckBox Content="{x:Static resources:Strings.Menu_Behaviour_Cleaner_AppDownloads}" IsChecked="{Binding CleanAppDownloads, Mode=TwoWay}" />
            </StackPanel>
        </controls:OptionControl>

        <controls:OptionControl Header="{x:Static resources:Strings.Menu_Behaviour_Cleaner_CleanNow_Title}" Description="{x:Static resources:Strings.Menu_Behaviour_Cleaner_CleanNow_Description}">
            <ui:Button Icon="Broom24" Content="{x:Static resources:Strings.Menu_Behaviour_Cleaner_CleanNow_Button}" Command="{Binding CleanNowCommand}" />
        </controls:OptionControl>

        <Border Style="{StaticResource SectionSeparator}" />
        <TextBlock Text="{x:Static resources:Strings.Menu_Behaviour_Channel_SectionTitle}" Style="{StaticResource SectionTitle}" />
        <TextBlock Text="{x:Static resources:Strings.Menu_Behaviour_Channel_SectionDescription}" Style="{StaticResource SectionDescription}" />

        <controls:OptionControl Header="{x:Static resources:Strings.Menu_Behaviour_Channel_Player}">
            <StackPanel Orientation="Horizontal">
                <ComboBox Width="200" Padding="10,5,10,5" IsEditable="True" ItemsSource="{Binding KnownChannels, Mode=OneTime}" Text="{Binding PlayerChannelTask.NewState, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                <ui:Button Margin="8,0,0,0" Icon="Search24" Content="{x:Static resources:Strings.Menu_Behaviour_Channel_Check}" Command="{Binding CheckPlayerChannelCommand}" />
            </StackPanel>
        </controls:OptionControl>

        <controls:OptionControl Header="{x:Static resources:Strings.Menu_Behaviour_Channel_Studio}">
            <StackPanel Orientation="Horizontal">
                <ComboBox Width="200" Padding="10,5,10,5" IsEditable="True" ItemsSource="{Binding KnownChannels, Mode=OneTime}" Text="{Binding StudioChannelTask.NewState, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                <ui:Button Margin="8,0,0,0" Icon="Search24" Content="{x:Static resources:Strings.Menu_Behaviour_Channel_Check}" Command="{Binding CheckStudioChannelCommand}" />
            </StackPanel>
        </controls:OptionControl>

        <controls:OptionControl
            Header="{x:Static resources:Strings.Menu_Behaviour_BlockUpdates_Title}"
            Description="{x:Static resources:Strings.Menu_Behaviour_BlockUpdates_Description}">
            <ui:ToggleSwitch IsChecked="{Binding BlockRobloxUpdates, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl
            Header="{x:Static resources:Strings.Menu_Behaviour_StaticFolder_Title}"
            Description="{x:Static resources:Strings.Menu_Behaviour_StaticFolder_Description}">
            <ui:ToggleSwitch IsChecked="{Binding UseStaticVersionFolder, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl
            Header="{x:Static resources:Strings.Menu_Behaviour_ChannelChange_Title}"
            Description="{x:Static resources:Strings.Menu_Behaviour_ChannelChange_Description}">
            <ComboBox Width="200" Padding="10,5,10,5" ItemsSource="{Binding ChannelChangeModes, Mode=OneTime}" SelectedItem="{Binding ChannelChangeMode, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </controls:OptionControl>

        <controls:OptionControl
            Header="{x:Static resources:Strings.Menu_Behaviour_PlayerVersion_Title}"
            Description="{x:Static resources:Strings.Menu_Behaviour_PlayerVersion_Description}">
            <ui:TextBox Width="240" Padding="10,5,10,5" PlaceholderText="version-xxxxxxxxxxxxxxxx" Text="{Binding PlayerVersionOverride, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
        </controls:OptionControl>

        <controls:OptionControl
            Header="{x:Static resources:Strings.Menu_Behaviour_StudioVersion_Title}"
            Description="{x:Static resources:Strings.Menu_Behaviour_StudioVersion_Description}">
            <ui:TextBox Width="240" Padding="10,5,10,5" PlaceholderText="version-xxxxxxxxxxxxxxxx" Text="{Binding StudioVersionOverride, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
        </controls:OptionControl>

        <controls:OptionControl
            Header="{x:Static resources:Strings.Menu_Behaviour_DownloadThreads_Title}"
            Description="{x:Static resources:Strings.Menu_Behaviour_DownloadThreads_Description}">
            <StackPanel Orientation="Horizontal">
                <Slider Width="180" Minimum="1" Maximum="8" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding DownloadThreads, Mode=TwoWay}" />
                <TextBlock Width="36" Margin="8,0,0,0" VerticalAlignment="Center" TextAlignment="Right" Text="{Binding DownloadThreads, Mode=OneWay}" />
            </StackPanel>
        </controls:OptionControl>
    </StackPanel>
</ui:UiPage>
