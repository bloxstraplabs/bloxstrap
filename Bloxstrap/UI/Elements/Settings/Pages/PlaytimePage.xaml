<ui:UiPage x:Class="Bloxstrap.UI.Elements.Settings.Pages.PlaytimePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:Bloxstrap.UI.Elements.Controls"
      xmlns:dmodels="clr-namespace:Bloxstrap.UI.ViewModels.Settings"
      xmlns:resources="clr-namespace:Bloxstrap.Resources"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance dmodels:PlaytimeViewModel}"
      d:DesignHeight="600" d:DesignWidth="800"
      Title="PlaytimePage"
      Scrollable="True">

    <StackPanel Margin="0,0,14,14">
        <controls:OptionControl Header="{x:Static resources:Strings.Menu_Playtime_Track_Title}" Description="{x:Static resources:Strings.Menu_Playtime_Track_Description}">
            <ui:ToggleSwitch IsChecked="{Binding TrackGameStats, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl Header="{x:Static resources:Strings.Menu_Playtime_Recap_Title}" Description="{x:Static resources:Strings.Menu_Playtime_Recap_Description}">
            <ui:ToggleSwitch IsChecked="{Binding SessionRecap, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl Header="{x:Static resources:Strings.Menu_Playtime_Performance_Title}" Description="{x:Static resources:Strings.Menu_Playtime_Performance_Description}">
            <ui:ToggleSwitch IsChecked="{Binding PerformanceLog, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl Header="{x:Static resources:Strings.Menu_Playtime_BreakReminder_Title}" Description="{x:Static resources:Strings.Menu_Playtime_BreakReminder_Description}">
            <ComboBox Width="160" Padding="10,5,10,5" ItemsSource="{Binding BreakReminderOptions, Mode=OneTime}" DisplayMemberPath="Label" SelectedValuePath="Minutes" SelectedValue="{Binding BreakReminderMinutes, Mode=TwoWay}" />
        </controls:OptionControl>

        <Grid Margin="0,16,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock FontSize="12" Text="{x:Static resources:Strings.Menu_Playtime_Total}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBlock FontSize="28" FontWeight="SemiBold" Text="{Binding TotalPlaytime}" />
            </StackPanel>
            <ui:Button Grid.Column="1" VerticalAlignment="Bottom" Icon="Delete24" Appearance="Danger" Content="{x:Static resources:Strings.Common_Reset}" Command="{Binding ResetCommand}" />
        </Grid>

        <TextBlock Margin="0,16,0,0" Text="{x:Static resources:Strings.Menu_Playtime_Empty}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Visibility="{Binding EmptyVisibility}" />

        <ItemsControl ItemsSource="{Binding Games}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ui:CardControl Margin="0,8,0,0" Padding="12">
                        <ui:CardControl.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="6" ClipToBounds="True" VerticalAlignment="Top">
                                    <Image Source="{Binding IconUrl, TargetNullValue={x:Null}}" RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <TextBlock FontSize="14" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock FontSize="12" Text="{Binding Details}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <ProgressBar Margin="0,6,0,0" Height="4" Minimum="0" Maximum="1" Value="{Binding Share, Mode=OneTime}" />
                                </StackPanel>
                            </Grid>
                        </ui:CardControl.Header>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding Playtime}" />
                    </ui:CardControl>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Visibility="{Binding SessionsVisibility, Mode=OneTime}">
            <Border Style="{StaticResource SectionSeparator}" />
            <TextBlock Text="{x:Static resources:Strings.Menu_Playtime_Sessions_Title}" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="{x:Static resources:Strings.Menu_Playtime_Sessions_Description}" Style="{StaticResource SectionDescription}" />

            <ItemsControl ItemsSource="{Binding Sessions, Mode=OneTime}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:CardControl Margin="0,8,0,0" Padding="12">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock FontSize="14" FontWeight="Medium" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock FontSize="12" Text="{Binding When}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <TextBlock FontSize="12" Margin="0,4,0,0" Text="{Binding Stats}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <Grid Width="240" Height="44">
                                <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" />
                                <Polyline Points="{Binding GpuPoints}" StrokeThickness="1.5" Stroke="{DynamicResource TextFillColorTertiaryBrush}" />
                                <Polyline Points="{Binding CpuPoints}" StrokeThickness="1.5">
                                    <Polyline.Stroke>
                                        <SolidColorBrush Color="{DynamicResource SystemAccentColorSecondary}" />
                                    </Polyline.Stroke>
                                </Polyline>
                            </Grid>
                        </ui:CardControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </StackPanel>
</ui:UiPage>
