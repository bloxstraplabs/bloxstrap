<ui:UiPage x:Class="Bloxstrap.UI.Elements.Settings.Pages.ExperienceLibraryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:resources="clr-namespace:Bloxstrap.Resources"
      xmlns:controls="clr-namespace:Bloxstrap.UI.Elements.Controls"
      xmlns:dmodels="clr-namespace:Bloxstrap.UI.ViewModels.Settings"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance Type=dmodels:ExperienceLibraryViewModel}"
      Title="ExperienceLibraryPage"
      Scrollable="True">
    <StackPanel Margin="0,0,14,16">
        <controls:LumiPageHeader PageTitle="{x:Static resources:LumiFeatureStrings.Menu_Experiences_Title}"
                                 Description="{x:Static resources:LumiFeatureStrings.Menu_Experiences_Description}" />

        <ui:Card Padding="16" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="{x:Static resources:LumiFeatureStrings.Menu_Experiences_AddTitle}" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="{x:Static resources:LumiFeatureStrings.Menu_Experiences_AddDescription}" Margin="0,4,0,10"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox Grid.Column="0" Margin="0,0,8,0" Height="38" VerticalContentAlignment="Center"
                                PlaceholderText="{x:Static resources:LumiFeatureStrings.Menu_Experiences_UrlPlaceholder}"
                                Text="{Binding ExperienceUrl, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:TextBox Grid.Column="1" Margin="0,0,8,0" Height="38" VerticalContentAlignment="Center"
                                PlaceholderText="{x:Static resources:LumiFeatureStrings.Menu_Experiences_NamePlaceholder}"
                                Text="{Binding ExperienceName, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:Button Grid.Column="2" Appearance="Primary" Content="{x:Static resources:LumiFeatureStrings.Menu_Experiences_Add}"
                               Command="{Binding AddExperienceCommand}" />
                </Grid>
                <TextBlock Text="{Binding Status}" Margin="0,8,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </ui:Card>

        <Grid Margin="0,0,0,9">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="4" Height="22" Margin="0,0,10,0" CornerRadius="2" VerticalAlignment="Center" Background="#8065E7" />
            <TextBlock Grid.Column="1" Text="{x:Static resources:LumiFeatureStrings.Menu_Experiences_ListTitle}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Border Grid.Column="2" Padding="9,3" CornerRadius="9" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                <TextBlock Text="{Binding Experiences.Count}" FontSize="12" FontWeight="SemiBold" />
            </Border>
        </Grid>

        <ui:Card Padding="10">
            <Grid MinHeight="220">
                <ListBox ItemsSource="{Binding Experiences}" SelectedItem="{Binding SelectedExperience, Mode=TwoWay}"
                         MinHeight="220" BorderThickness="0" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12,9" Margin="0,2" CornerRadius="8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" Margin="0,0,12,0" CornerRadius="10" Background="#223D9BFF">
                                        <Grid>
                                            <ui:SymbolIcon Symbol="Apps28" Foreground="#8FB6FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <ui:SymbolIcon Symbol="Star12" Foreground="#FFD36E" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0">
                                                <ui:SymbolIcon.Style>
                                                    <Style TargetType="ui:SymbolIcon">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:SymbolIcon.Style>
                                            </ui:SymbolIcon>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding PlaceId, StringFormat='ID {0}'}" Margin="0,2,0,0" FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        <TextBlock Text="{Binding LastPlayedDescription}" Margin="0,2,0,0" FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="300" IsHitTestVisible="False">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Experiences.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <ui:SymbolIcon Symbol="Apps28" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" FontSize="26" />
                    <TextBlock Text="{x:Static resources:LumiFeatureStrings.Menu_Experiences_Empty}" Margin="0,8,0,0" TextAlignment="Center"
                               TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </Grid>
        </ui:Card>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <ui:Button Content="{x:Static resources:LumiFeatureStrings.Menu_Experiences_Open}" Command="{Binding OpenExperienceCommand}"
                       IsEnabled="{Binding IsExperienceSelected}" Appearance="Primary" Margin="0,0,8,0" />
            <ui:Button Content="{Binding FavoriteActionText}" Command="{Binding ToggleFavoriteCommand}"
                       IsEnabled="{Binding IsExperienceSelected}" Margin="0,0,8,0" />
            <ui:Button Content="{x:Static resources:LumiFeatureStrings.Menu_Experiences_Remove}" Command="{Binding RemoveExperienceCommand}"
                       IsEnabled="{Binding IsExperienceSelected}" Appearance="Danger" />
        </StackPanel>
    </StackPanel>
</ui:UiPage>
