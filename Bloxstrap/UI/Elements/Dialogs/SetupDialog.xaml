<Window
    x:Class="Bloxstrap.UI.Elements.Dialogs.SetupDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:resources="clr-namespace:Bloxstrap.Resources"
    Title="{x:Static resources:Strings.Setup_Title}"
    Width="920"
    Height="620"
    ResizeMode="NoResize"
    WindowStyle="None"
    WindowStartupLocation="CenterScreen"
    Background="#101014"
    Foreground="#F2F1EC"
    FontFamily="Segoe UI Variable Text, Segoe UI"
    KeyDown="Window_KeyDown"
    Loaded="Window_Loaded">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#F5B800" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#26F5B800" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#1A1A20" />
        <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#22222A" />
        <SolidColorBrush x:Key="LineBrush" Color="#2E2E36" />
        <SolidColorBrush x:Key="MutedBrush" Color="#9C9AA3" />
        <SolidColorBrush x:Key="DimBrush" Color="#5F5D66" />
        <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>

        <LinearGradientBrush x:Key="TileBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#FFF04A" />
            <GradientStop Offset="1" Color="#FFC21A" />
        </LinearGradientBrush>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#141414" />
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="28,11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="2" CornerRadius="22" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#F2F1EC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="20" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#1FFFFFFF" />
                                <Setter Property="Foreground" Value="#F2F1EC" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#1FFFFFFF" />
                                <Setter Property="Foreground" Value="#F2F1EC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChoiceCard" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#F2F1EC" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1.5" CornerRadius="14" Padding="18,16">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#F2F1EC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FeatureTile" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="#F2F1EC" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Root" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1.5" CornerRadius="14" Padding="16,14">
                            <Grid>
                                <ContentPresenter Margin="0,0,28,0" />
                                <Border x:Name="Check" Width="22" Height="22" CornerRadius="11" HorizontalAlignment="Right" VerticalAlignment="Top" BorderThickness="1.5" BorderBrush="{StaticResource DimBrush}">
                                    <Path x:Name="CheckMark" Margin="2,2,0,0" Data="M 3,8.5 L 6.5,12 L 13,5" Stroke="#141414" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed" />
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Check" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Check" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#F2F1EC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Swatch" TargetType="RadioButton">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="Ring" Stroke="Transparent" StrokeThickness="2.5" />
                            <Ellipse Margin="6" Fill="{TemplateBinding Background}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource DimBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource MutedBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="#F2F1EC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StepTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="34" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="StepSubtitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Margin" Value="0,8,0,24" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="CardText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>
    </Window.Resources>

    <Grid ClipToBounds="True" Background="Transparent" MouseLeftButtonDown="Background_MouseLeftButtonDown">
        <Canvas IsHitTestVisible="False">
            <Ellipse x:Name="GlowA" Width="540" Height="540" Canvas.Left="-180" Canvas.Top="-240" Opacity="0.30" Fill="{DynamicResource AccentBrush}">
                <Ellipse.Effect>
                    <BlurEffect Radius="180" />
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse x:Name="GlowB" Width="460" Height="460" Canvas.Left="580" Canvas.Top="320" Opacity="0.18" Fill="{DynamicResource AccentBrush}">
                <Ellipse.Effect>
                    <BlurEffect Radius="180" />
                </Ellipse.Effect>
            </Ellipse>
        </Canvas>

        <Grid x:Name="WelcomeView">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Viewbox Width="160" Height="160" HorizontalAlignment="Center">
                    <Canvas Width="200" Height="200">
                        <Canvas.RenderTransform>
                            <RotateTransform Angle="10" CenterX="100" CenterY="100" />
                        </Canvas.RenderTransform>
                        <Rectangle x:Name="TileTL" Width="84" Height="84" Canvas.Left="12" Canvas.Top="12" RadiusX="12" RadiusY="12" Fill="{StaticResource TileBrush}" Opacity="0">
                            <Rectangle.RenderTransform>
                                <TranslateTransform />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle x:Name="TileTR" Width="84" Height="84" Canvas.Left="104" Canvas.Top="12" RadiusX="12" RadiusY="12" Fill="{StaticResource TileBrush}" Opacity="0">
                            <Rectangle.RenderTransform>
                                <TranslateTransform />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle x:Name="TileBL" Width="84" Height="84" Canvas.Left="12" Canvas.Top="104" RadiusX="12" RadiusY="12" Fill="{StaticResource TileBrush}" Opacity="0">
                            <Rectangle.RenderTransform>
                                <TranslateTransform />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle x:Name="TileBR" Width="84" Height="84" Canvas.Left="104" Canvas.Top="104" RadiusX="12" RadiusY="12" Fill="{StaticResource TileBrush}" Opacity="0">
                            <Rectangle.RenderTransform>
                                <TranslateTransform />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle x:Name="Chip" Width="56" Height="44" Canvas.Left="72" Canvas.Top="78" RadiusX="10" RadiusY="10" Fill="#1C1C1F" RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform>
                                <ScaleTransform ScaleX="0" ScaleY="0" />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Canvas>
                </Viewbox>

                <StackPanel x:Name="WelcomeText" Margin="0,30,0,0" Opacity="0">
                    <StackPanel.RenderTransform>
                        <TranslateTransform Y="18" />
                    </StackPanel.RenderTransform>
                    <TextBlock HorizontalAlignment="Center" FontFamily="{StaticResource DisplayFont}" FontSize="46" FontWeight="Bold" Text="{x:Static resources:Strings.Setup_Welcome_Heading}" />
                    <TextBlock Margin="0,10,0,0" MaxWidth="500" HorizontalAlignment="Center" TextAlignment="Center" FontSize="16" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Text="{x:Static resources:Strings.Setup_Welcome_Subheading}" />
                    <Button x:Name="StartButton" IsDefault="True" Margin="0,34,0,0" HorizontalAlignment="Center" Style="{StaticResource PrimaryButton}" Content="{x:Static resources:Strings.Setup_Start}" Click="StartButton_Click" />
                    <Button Margin="0,8,0,0" HorizontalAlignment="Center" Style="{StaticResource GhostButton}" Content="{x:Static resources:Strings.Setup_Skip}" Click="SkipButton_Click" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <Grid x:Name="StepsView" Visibility="Collapsed" Opacity="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#B30B0B0E" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="26,28,20,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <Image Width="28" Height="28" Source="pack://application:,,,/reistrap.ico" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="Bold" Text="reistrap" />
                    </StackPanel>
                    <StackPanel x:Name="StepList" Grid.Row="1" Margin="0,44,0,0" />
                    <Button Grid.Row="2" HorizontalAlignment="Left" Margin="-16,0,0,0" Style="{StaticResource GhostButton}" Content="{x:Static resources:Strings.Setup_Skip}" Click="SkipButton_Click" />
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="44,44,40,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid x:Name="StepHost" Grid.Row="0">
                    <Grid.RenderTransform>
                        <TranslateTransform />
                    </Grid.RenderTransform>

                    <StackPanel x:Name="ImportStep">
                        <TextBlock Style="{StaticResource StepTitle}" Text="{x:Static resources:Strings.Setup_Import_Heading}" />
                        <TextBlock Style="{StaticResource StepSubtitle}" Text="{x:Static resources:Strings.Setup_Import_Subheading}" />
                        <StackPanel x:Name="ImportChoices" />
                    </StackPanel>

                    <StackPanel x:Name="LookStep">
                        <TextBlock Style="{StaticResource StepTitle}" Text="{x:Static resources:Strings.Setup_Look_Heading}" />
                        <TextBlock Style="{StaticResource StepSubtitle}" Text="{x:Static resources:Strings.Setup_Look_Subheading}" />
                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Text="{x:Static resources:Strings.Menu_Appearance_Global_Theme_Title}" />
                        <UniformGrid x:Name="ThemeChoices" Margin="0,10,-10,20" Columns="3" />
                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Text="{x:Static resources:Strings.Menu_Appearance_AccentTheme_Title}" />
                        <WrapPanel x:Name="AccentChoices" Margin="0,10,0,0" />
                    </StackPanel>

                    <StackPanel x:Name="FeaturesStep">
                        <TextBlock Style="{StaticResource StepTitle}" Text="{x:Static resources:Strings.Setup_Features_Heading}" />
                        <TextBlock Style="{StaticResource StepSubtitle}" Text="{x:Static resources:Strings.Setup_Features_Subheading}" />
                        <UniformGrid x:Name="FeatureChoices" Columns="2" Margin="0,0,-10,0" />
                    </StackPanel>

                    <StackPanel x:Name="PerformanceStep">
                        <TextBlock Style="{StaticResource StepTitle}" Text="{x:Static resources:Strings.Setup_Performance_Heading}" />
                        <TextBlock Style="{StaticResource StepSubtitle}" Text="{x:Static resources:Strings.Setup_Performance_Subheading}" />
                        <StackPanel x:Name="PerformanceChoices" />
                    </StackPanel>

                    <StackPanel x:Name="DoneStep" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Grid Width="110" Height="110" HorizontalAlignment="Center">
                            <Ellipse x:Name="DoneCircle" Fill="{DynamicResource AccentBrush}" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform ScaleX="0" ScaleY="0" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Path x:Name="DoneCheck" Data="M 32,57 L 49,74 L 80,40" Stroke="#141414" StrokeThickness="9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeDashArray="10 10" StrokeDashOffset="10" />
                        </Grid>
                        <TextBlock Margin="0,28,0,0" HorizontalAlignment="Center" Style="{StaticResource StepTitle}" Text="{x:Static resources:Strings.Setup_Done_Heading}" />
                        <TextBlock MaxWidth="440" HorizontalAlignment="Center" TextAlignment="Center" Style="{StaticResource StepSubtitle}" Text="{x:Static resources:Strings.Setup_Done_Body}" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BackButton" Grid.Column="0" Style="{StaticResource GhostButton}" Content="{x:Static resources:Strings.Setup_Back}" Click="BackButton_Click" />
                    <Button x:Name="NextButton" IsDefault="True" Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="{x:Static resources:Strings.Setup_Next}" Click="NextButton_Click" />
                </Grid>
            </Grid>
        </Grid>

        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0" Width="40" Height="34" Padding="0" Style="{StaticResource GhostButton}" Content="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" ToolTip="{x:Static resources:Strings.Common_Close}" Click="SkipButton_Click" />
    </Grid>
</Window>
